{
  "manifestVersion": 5,
  "id": "de.tpmarketing.indesign.tplektor",
  "name": "TP Lektor",
  "version": "2.2.0",
  "main": "index.html",
  "host": {
    "app": "ID",
    "minVersion": "18.5.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "TP Lektor"
      },
      "minimumSize": {
        "width": 260,
        "height": 90
      },
      "maximumSize": {
        "width": 3000,
        "height": 5000
      },
      "preferredDockedSize": {
        "width": 350,
        "height": 500
      },
      "preferredFloatingSize": {
        "width": 350,
        "height": 500
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-on-dark.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "darkest",
            "dark"
          ],
          "species": [
            "chrome"
          ]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/panel-on-light.png",
          "scale": [
            1,
            2
          ],
          "theme": [
            "lightest",
            "light"
          ],
          "species": [
            "chrome"
          ]
        }
      ]
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "https://api.openai.com"
      ]
    },
    "localFileSystem": "request"
  },
  "icons": [
    {
      "width": 23,
      "height": 23,
      "path": "icons/panel-on-dark.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "darkest",
        "dark"
      ]
    },
    {
      "width": 23,
      "height": 23,
      "path": "icons/panel-on-light.png",
      "scale": [
        1,
        2
      ],
      "theme": [
        "lightest",
        "light"
      ]
    }
  ]
}
